# HAHAWEEK runtime configuration. Copy to .env (never commit .env).
# HAHAWEEK_* names take precedence; the older unprefixed names still work.

# RPC endpoint. Use a keyed provider for production; the public endpoint is rate-limited.
# The URL is redacted (scheme + host only) in logs, health output, state.json,
# persisted source IDs and CI artifacts.
HAHAWEEK_RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
CONFIRMATIONS=3
RPC_TIMEOUT_MS=15000

# Throughput (Robinhood Chain makes ~10 blocks/s, ~860k blocks/day).
# Blocks per verified batch (one processing context + authority + cursor advance + DB save).
HAHAWEEK_CHUNK_SIZE=500
# Batches per ingestion pass (500 x 20 = 10,000 blocks per pass).
HAHAWEEK_MAX_BATCHES_PER_RUN=20
# eth_getLogs block range per call inside a batch (defaults to HAHAWEEK_CHUNK_SIZE).
# HAHAWEEK_LOG_CHUNK_SIZE=500
# Concurrent block-header requests while verifying a batch.
HAHAWEEK_HEADER_CONCURRENCY=8
MAX_RUNTIME_MS=900000
MAX_RPC_CALLS_PER_RUN=4096

# Backfill: first block to ingest when no cursor exists yet.
# Empty = start at the current safe head. Ignored once a cursor exists.
HAHAWEEK_START_BLOCK=

# Runner loop (src/runner.js).
HAHAWEEK_LOOP_SLEEP_MS=5000
HAHAWEEK_CATCHUP_SLEEP_MS=250
RUNNER_MAX_BACKOFF_MS=60000
# exit (default): exit 78 on fail-closed STOP. hold: stay alive idle (used in Docker).
HAHAWEEK_RUNNER_ON_STOP=exit

# Storage
HAHAWEEK_DATA_DIR=./data
