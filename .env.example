# HAHAWEEK runtime configuration. Copy to .env (never commit .env).
# HAHAWEEK_* names take precedence; the older unprefixed names still work.
# Every value below is optional: leave it unset to use the profile default.

# Profile: free (default) or fast.
#   free: public RPC, no key, GitHub Actions free runner or Android/Termux.
#         Polite and data-light; does NOT keep up with the chain head.
#   fast: keyed/paid RPC on a host that must track the head.
HAHAWEEK_PROFILE=free

# RPC endpoint. The public endpoint needs no key. The URL is redacted
# (scheme + host only) in logs, health output, state.json, persisted source IDs
# and CI artifacts.
HAHAWEEK_RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
CONFIRMATIONS=3

#                                   free     fast
# Blocks per verified batch (processing context + authority + cursor advance + DB save).
# HAHAWEEK_CHUNK_SIZE=              100      500
# eth_getLogs block range per call. The public RPC rejects queries matching
# more than 10,000 logs (~9,000 PoolManager blocks).
# HAHAWEEK_LOG_CHUNK_SIZE=          100      500
# Batches per pass.
# HAHAWEEK_MAX_BATCHES_PER_RUN=     5        20
# Concurrent eth_getBlockByNumber requests while verifying a batch.
# HAHAWEEK_HEADER_CONCURRENCY=      2        8
# MAX_RUNTIME_MS=                   900000   900000
# MAX_RPC_CALLS_PER_RUN=            1000     4096

# RPC retry: exponential backoff + jitter on HTTP 429/5xx, timeouts and
# network errors; Retry-After is honoured (a Retry-After longer than the max
# delay ends the pass instead of waiting). Failure leaves the cursor unchanged.
# HAHAWEEK_RPC_TIMEOUT_MS=          30000    15000   (legacy: RPC_TIMEOUT_MS)
# HAHAWEEK_RPC_RETRY_MAX_ATTEMPTS=  6        4
# HAHAWEEK_RPC_RETRY_BASE_MS=       2000     250
# HAHAWEEK_RPC_RETRY_MAX_MS=        60000    10000

# Backfill: first block to ingest when no cursor exists yet.
# Empty = start at the current safe head. Ignored once a cursor exists.
HAHAWEEK_START_BLOCK=

# Runner loop (src/runner.js).
# HAHAWEEK_LOOP_SLEEP_MS=           60000    5000
# HAHAWEEK_CATCHUP_SLEEP_MS=        15000    250
RUNNER_MAX_BACKOFF_MS=60000
# exit (default): exit 78 on fail-closed STOP. hold: stay alive idle (used in Docker).
HAHAWEEK_RUNNER_ON_STOP=exit

# Storage
HAHAWEEK_DATA_DIR=./data
